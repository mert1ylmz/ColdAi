# ──────────────────────────────────────────────
# ColdAI Backend — Ortam Değişkenleri
# ──────────────────────────────────────────────
# Bu dosyayı .env olarak kopyalayın ve değerleri güncelleyin.

# Veritabanı (SQLite development, PostgreSQL production)
# Development:
DATABASE_URL=sqlite+aiosqlite:///./coldai.db
# Production:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/coldai

# JWT Secret Key (production'da mutlaka değiştirin!)
SECRET_KEY=coldai-dev-secret-key-change-in-production

# Tesseract OCR yolu (PATH'te değilse)
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/Mac: /usr/bin/tesseract
TESSERACT_CMD=
